<main class="main">
<header class="topbar"><div><div class="eyebrow">BELGE MERKEZİ / YÖNETİM PANELİ</div><h1 id="pageTitle">Arşiv Kontrol Paneli</h1><div style="color:var(--muted);font-size:13px">Belgelerinizi kaydedin, numaralandırın ve kolayca bulun.</div></div><div class="topright"><div style="text-align:right"><b style="color:var(--text)">Yerel Arşiv</b><br><span id="today"></span></div><div class="avatar">♙</div><div class="usertext"><b style="color:var(--text)">Yönetici</b><br>Oturum açık</div><button id="logoutBtn" class="smallbtn" title="Oturumu kapat">Çıkış</button></div></header>
<section id="homeSection" class="section active">
<div class="stats">
 <div class="stat"><div class="symbol">▤</div><div><strong id="totalStat">0</strong><span>Toplam Belge</span></div></div>
 <div class="stat"><div class="symbol">▰</div><div><strong id="catStat">0</strong><span>Kategori</span></div></div>
 <div class="stat"><div class="symbol">▧</div><div><strong id="scanStat">0</strong><span>Taranan / Görsel</span></div></div>
 <div class="stat"><div class="symbol">⇩</div><div><strong id="sizeStat">0 B</strong><span>Ek Dosya Boyutu</span></div></div>
</div>
<div class="actions">
 <button class="action" data-goto="new"><span class="symbol">⊕</span><span><b>Yeni Kayıt Ekle</b><small>Belgeyi numaralandır</small></span></button>
