<div id="loginScreen" style="position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;background:radial-gradient(ellipse at 50% 0%,#14572f 0,transparent 45%),#030a06;">
  <form id="loginForm" style="width:min(420px,100%);padding:30px;border:1px solid #1b7042;border-radius:22px;background:linear-gradient(145deg,#0c2517,#06110b);box-shadow:0 25px 80px #0009;">
    <div style="width:66px;height:58px;border-radius:16px;background:linear-gradient(135deg,#79ffb0,#00b85a);display:grid;place-items:center;color:#063019;font-size:34px;margin:0 auto 16px;">▰</div>
    <div style="text-align:center;color:#8effc1;font-size:11px;letter-spacing:2px;">BELGE YÖNETİM SİSTEMİ</div>
    <h1 style="text-align:center;margin:6px 0 4px;font-size:29px;">ETÜT ARŞİV</h1>
    <p style="text-align:center;color:#9bb9a8;margin:0 0 25px;font-size:13px;">Devam etmek için giriş yapın</p>
    <label for="loginUser" style="display:block;color:#9bb9a8;font-size:13px;margin:0 0 6px;">Kullanıcı adı</label>
    <input id="loginUser" autocomplete="username" required style="width:100%;border:1px solid #24543b;border-radius:10px;background:#06150e;color:#effff5;padding:13px;margin-bottom:15px;" placeholder="Kullanıcı adınızı girin">
    <label for="loginPass" style="display:block;color:#9bb9a8;font-size:13px;margin:0 0 6px;">Şifre</label>
    <input id="loginPass" type="password" autocomplete="current-password" required style="width:100%;border:1px solid #24543b;border-radius:10px;background:#06150e;color:#effff5;padding:13px;margin-bottom:16px;" placeholder="Şifrenizi girin">
    <div id="loginError" style="display:none;color:#ff9b9f;font-size:13px;margin-bottom:12px;">Kullanıcı adı veya şifre hatalı.</div>
    <button id="loginSubmit" type="button" style="width:100%;border:1px solid #39f28a;border-radius:10px;padding:13px;background:linear-gradient(135deg,#19c95d,#07863b);color:#03190b;font-weight:800;">Giriş Yap →</button>
    <p style="text-align:center;color:#7aa68b;font-size:11px;margin:18px 0 0;">Güvenli arşiv erişimi</p>
  </form>
</div>

