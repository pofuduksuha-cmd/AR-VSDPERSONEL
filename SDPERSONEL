<div class="toast" id="toast" role="status"></div>
<script>
(function(){
'use strict';
const loginScreen=document.getElementById('loginScreen');
const loginForm=document.getElementById('loginForm');
function attemptLogin(ev){
  if(ev) ev.preventDefault();
  const userInput=document.getElementById('loginUser');
  const passInput=document.getElementById('loginPass');
  const error=document.getElementById('loginError');
  const u=(userInput.value||'').trim().toLocaleLowerCase('tr-TR');
  const p=(passInput.value||'').trim();
  if(u==='admin' && p==='etütproje46'){
    loginScreen.style.display='none';
    error.style.display='none';
    document.body.classList.add('authenticated');
  }else{
    error.textContent='Kullanıcı adı veya şifre hatalı. Kullanıcı: admin';
    error.style.display='block';
    passInput.value='';
    passInput.focus();
  }
}
loginForm.addEventListener('submit',attemptLogin);
document.getElementById('loginSubmit').addEventListener('click',attemptLogin);
document.getElementById('logoutBtn')?.addEventListener('click',function(){
  loginScreen.style.display='flex';
  document.getElementById('loginUser').value='';
  document.getElementById('loginPass').value='';
});
const $=id=>document.getElementById(id);
const DB_NAME='EtutArsivFilesV3', STORE='files';
let db=null, records=[], currentPage='home', scanDataUrl='';
const titles={home:'Arşiv Kontrol Paneli',new:'Yeni Arşiv Kaydı',scan:'Belge Tara',archive:'Arşiv Kayıtları',categories:'Kategoriler',search:'Arşivde Belge Bul',reports:'Raporlar ve PDF',backup:'Yedekle / Geri Yükle',settings:'Ayarlar'};
const today=new Date(); $('today').textContent=today.toLocaleDateString('tr-TR',{day:'2-digit',month:'short',year:'numeric'});
const dateStr= d=>{let x=d?new Date(d+'T12:00:00'):new Date();return isNaN(x)?'—':x.toLocaleDateString('tr-TR')};
const escapeHtml=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmtSize=n=>{if(!n)return '—';if(n<1024)return n+' B';if(n<1048576)return (n/1024).toFixed(1)+' KB';return (n/1048576).toFixed(2)+' MB'};
function toast(msg){const t=$('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),3300)}
function readRecords(){try{records=JSON.parse(localStorage.getItem('etutArsivRecordsV3')||'[]');if(!Array.isArray(records))records=[]}catch(e){records=[]}}
function persist(){try{localStorage.setItem('etutArsivRecordsV3',JSON.stringify(records));return true}catch(e){toast('Kayıt bilgileri saklanamadı. Tarayıcı depolama alanı dolu olabilir.');return false}}
function openDb(){return new Promise((resolve,reject)=>{if(!('indexedDB'in window)){resolve(null);return}let req=indexedDB.open(DB_NAME,1);req.onupgradeneeded=()=>{let d=req.result;if(!d.objectStoreNames.contains(STORE))d.createObjectStore(STORE)};req.onsuccess=()=>{db=req.result;resolve(db)};req.onerror=()=>resolve(null)})}
function filePut(id,file){return new Promise((resolve,reject)=>{if(!db){reject(new Error('Dosya saklama kullanılamıyor'));return}let tx=db.transaction(STORE,'readwrite');tx.objectStore(STORE).put({blob:file,name:file.name,type:file.type,size:file.size},id);tx.oncomplete=()=>resolve(true);tx.onerror=()=>reject(tx.error||new Error('Dosya kaydedilemedi'))})}
function fileGet(id){return new Promise(resolve=>{if(!db){resolve(null);return}let tx=db.transaction(STORE,'readonly'),r=tx.objectStore(STORE).get(id);r.onsuccess=()=>resolve(r.result||null);r.onerror=()=>resolve(null)})}
function fileDel(id){return new Promise(resolve=>{if(!db){resolve();return}let tx=db.transaction(STORE,'readwrite');tx.objectStore(STORE).delete(id);tx.oncomplete=()=>resolve();tx.onerror=()=>resolve()})}
function genNo(){let y=new Date().getFullYear(),nums=records.map(r=>{let m=String(r.number||'').match(/(\d+)$/);return m?+m[1]:0});return 'ET-'+y+'-'+String(Math.max(0,...nums)+1).padStart(4,'0')}
function uniqueId(){return 'r'+Date.now().toString(36)+Math.random().toString(36).slice(2,8)}
function categories(){return [...new Set(records.map(r=>(r.category||'').trim()).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'tr'))}
function updateCategoryUi(){let cats=categories();$('categoryOptions').innerHTML=cats.map(c=>`<option value="${escapeHtml(c)}"></option>`).join('');let sel=$('filterCategory'),old=sel.value;sel.innerHTML='<option value="">Tüm kategoriler</option>'+cats.map(c=>`<option>${escapeHtml(c)}</option>`).join('');if(cats.includes(old))sel.value=old;$('categoryList').innerHTML=cats.length?cats.map(c=>`<div class="settingsrow"><b>${escapeHtml(c)}</b><span class="pill">${records.filter(r=>r.category===c).length} belge</span></div>`).join(''):'<div class="empty">Henüz kategori yok. Yeni kayıt oluştururken kategori ekleyebilirsiniz.</div>'}
function updateStats(){$('totalStat').textContent=records.length;$('catStat').textContent=categories().length;$('scanStat').textContent=records.filter(r=>r.fileType&&r.fileType.startsWith('image/')).length;$('sizeStat').textContent=fmtSize(records.reduce((s,r)=>s+(r.fileSize||0),0));updateCategoryUi();renderRecent();renderArchive();renderReports()}
function searchable(r){return [r.number,r.name,r.category,r.type,r.date,r.department,r.description,r.fileName].join(' ').toLocaleLowerCase('tr-TR')}
function filtered(){let q=($('searchInput').value||'').trim().toLocaleLowerCase('tr-TR'),cat=$('filterCategory').value,type=$('filterType').value,sort=$('sortBy').value;let arr=records.filter(r=>(!q||searchable(r).includes(q))&&(!cat||r.category===cat)&&(!type||r.type===type));arr.sort((a,b)=>sort==='oldest'?a.createdAt-b.createdAt:sort==='name'?a.name.localeCompare(b.name,'tr'):sort==='number'?a.number.localeCompare(b.number,'tr'):b.createdAt-a.createdAt);return arr}
function actionButtons(r){return `<div class="rowbuttons"><button title="Görüntüle" data-act="view" data-id="${r.id}">◉</button><button title="İndir" data-act="download" data-id="${r.id}" ${r.fileId?'':'disabled'}>⇩</button><button title="Düzenle" data-act="edit" data-id="${r.id}">✎</button><button class="danger" title="Sil" data-act="delete" data-id="${r.id}">×</button></div>`}
function rowHtml(r){return `<tr><td><span class="pill">${escapeHtml(r.number)}</span></td><td class="name">${escapeHtml(r.name)}<small>${escapeHtml(r.fileName||'Dosya eklenmedi')}</small></td><td>${escapeHtml(r.category||'Genel')}<small>${escapeHtml(r.type||'Diğer')}</small></td><td>${dateStr(r.date)}</td><td>${r.fileName?escapeHtml(fmtSize(r.fileSize)):'—'}</td><td>${actionButtons(r)}</td></tr>`}
function renderArchive(){let arr=filtered();$('archiveRows').innerHTML=arr.map(rowHtml).join('');$('emptyMessage').style.display=arr.length?'none':'block';$('recordCount').textContent=arr.length+' / '+records.length+' kayıt';}
function renderRecent(){let arr=[...records].sort((a,b)=>b.createdAt-a.createdAt).slice(0,5);$('recentList').innerHTML=arr.length?`<div class="tablewrap"><table><thead><tr><th>Arşiv No</th><th>Belge Adı</th><th>Kategori</th><th>Tarih</th><th>İşlem</th></tr></thead><tbody>${arr.map(r=>`<tr><td><span class="pill">${escapeHtml(r.number)}</span></td><td class="name">${escapeHtml(r.name)}</td><td>${escapeHtml(r.category||'Genel')}</td><td>${dateStr(r.date)}</td><td><button class="smallbtn" data-act="view" data-id="${r.id}">Aç</button></td></tr>`).join('')}</tbody></table></div>`:'<div class="empty">Arşiv henüz boş. İlk belgenizi eklemek için “Yeni Kayıt Ekle” düğmesini kullanın.</div>'}
function renderReports(){$('reportRows').innerHTML=[...records].sort((a,b)=>b.createdAt-a.createdAt).map(r=>`<tr><td>${escapeHtml(r.number)}</td><td>${escapeHtml(r.name)}</td><td>${dateStr(r.date)}</td><td>${escapeHtml(r.fileName||'Ek yok')}</td><td><button class="smallbtn" data-act="pdf" data-id="${r.id}">PDF / Yazdır</button></td></tr>`).join('')||'<tr><td colspan="5">Henüz kayıt yok.</td></tr>'}
function go(page){currentPage=page;document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));let el=$(page+'Section');if(el)el.classList.add('active');document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===page));$('pageTitle').textContent=titles[page]||'ETÜT ARŞİV';if(page==='archive')renderArchive();if(page==='search')runQuickSearch();window.scrollTo({top:0,behavior:'smooth'})}
function clearForm(){ $('recordForm').reset();$('editId').value='';$('docNo').value=genNo();$('docDate').value=new Date().toISOString().slice(0,10);$('formHeading').textContent='Yeni Arşiv Kaydı';$('docFile').value='';$('fileHint').textContent='Dosya seçilmezse sadece kayıt bilgileri kaydedilir. Büyük dosyalar tarayıcı depolama sınırına takılabilir.'}
function startEdit(id){let r=records.find(x=>x.id===id);if(!r)return;go('new');$('editId').value=id;$('formHeading').textContent='Arşiv Kaydını Düzenle';$('docNo').value=r.number;$('docDate').value=r.date||'';$('docName').value=r.name;$('docCategory').value=r.category||'';$('docType').value=r.type||'Diğer';$('docDepartment').value=r.department||'';$('docDescription').value=r.description||'';$('fileHint').textContent=r.fileName?'Mevcut dosya: '+r.fileName+' (yeni dosya seçerseniz değiştirilir)':'Mevcut ek yok.'}
async function downloadRecord(r){if(!r)return;if(r.fileId){let f=await fileGet(r.fileId);if(f&&f.blob){let url=URL.createObjectURL(f.blob),a=document.createElement('a');a.href=url;a.download=f.name||r.fileName||'belge';a.click();setTimeout(()=>URL.revokeObjectURL(url),3000);return}}if(r.dataUrl){let a=document.createElement('a');a.href=r.dataUrl;a.download=r.fileName||'belge';a.click();return}toast('Bu kayda ekli bir dosya bulunmuyor.')}
async function viewRecord(id){let r=records.find(x=>x.id===id);if(!r)return;let file=null;if(r.fileId)file=await fileGet(r.fileId);let content=`<!doctype html><html lang="tr"><meta charset="utf-8"><title>${escapeHtml(r.number)} - ${escapeHtml(r.name)}</title><style>body{font:14px Arial;color:#111;max-width:850px;margin:35px auto;padding:0 24px}h1{font-size:24px;border-bottom:3px solid #168044;padding-bottom:12px}table{width:100%;border-collapse:collapse;margin:20px 0}td{border:1px solid #bbb;padding:10px}td:first-child{width:180px;background:#f0f5f1;font-weight:bold}.actions{margin:20px 0}@media print{.actions{display:none}}img{max-width:100%;max-height:700px;object-fit:contain}</style><h1>ETÜT ARŞİV — BELGE KAYIT FİŞİ</h1><div class="actions"><button onclick="window.print()">Yazdır / PDF oluştur</button></div><table><tr><td>Arşiv / Evrak No</td><td>${escapeHtml(r.number)}</td></tr><tr><td>Belge Adı</td><td>${escapeHtml(r.name)}</td></tr><tr><td>Kategori</td><td>${escapeHtml(r.category||'—')}</td></tr><tr><td>Belge Türü</td><td>${escapeHtml(r.type||'—')}</td></tr><tr><td>Belge Tarihi</td><td>${dateStr(r.date)}</td></tr><tr><td>Birim / Gönderen</td><td>${escapeHtml(r.department||'—')}</td></tr><tr><td>Açıklama</td><td>${escapeHtml(r.description||'—').replace(/\\n/g,'<br>')}</td></tr><tr><td>Ek Dosya</td><td>${escapeHtml(r.fileName||'Ek yok')}</td></tr></table>${file&&file.blob&&file.blob.type.startsWith('image/')?'<h2>Taranan Belge</h2><img src="'+URL.createObjectURL(file.blob)+'">':''}<p style="color:#555;font-size:11px">Oluşturulma: ${new Date(r.createdAt).toLocaleString('tr-TR')}</p></html>`;let w=window.open('','_blank');if(!w){toast('Açılır pencere engellendi. Bu site için açılır pencerelere izin verin.');return}w.document.open();w.document.write(content);w.document.close()}
function pdfRecord(id){viewRecord(id)}
function printList(){window.print()}
function runQuickSearch(){let q=($('quickSearch').value||'').trim().toLocaleLowerCase('tr-TR');let arr=records.filter(r=>!q||searchable(r).includes(q));$('quickResults').innerHTML=arr.length?`<div class="tablewrap"><table><thead><tr><th>Arşiv No</th><th>Belge Adı</th><th>Kategori</th><th>Tarih</th><th>İşlem</th></tr></thead><tbody>${arr.map(r=>`<tr><td><span class="pill">${escapeHtml(r.number)}</span></td><td class="name">${escapeHtml(r.name)}<small>${escapeHtml(r.fileName||'')}</small></td><td>${escapeHtml(r.category||'Genel')}</td><td>${dateStr(r.date)}</td><td>${actionButtons(r)}</td></tr>`).join('')}</tbody></table></div>`:'<div class="empty">Aramanızla eşleşen belge bulunamadı.</div>'}
function csvExport(){let rows=[['Arşiv No','Belge Adı','Kategori','Tür','Belge Tarihi','Birim','Açıklama','Dosya Adı'],...records.map(r=>[r.number,r.name,r.category,r.type,r.date,r.department,r.description,r.fileName])];let csv='\\ufeff'+rows.map(row=>row.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(';')).join('\\r\\n');let blob=new Blob([csv],{type:'text/csv;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='etut-arsiv-listesi.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),3000)}
async function saveRecord(e,keepNew=false){if(e)e.preventDefault();let id=$('editId').value||uniqueId(),old=records.find(r=>r.id===id),f=$('docFile').files[0];let number=$('docNo').value.trim()||genNo();if(records.some(r=>r.number.toLocaleLowerCase('tr-TR')===number.toLocaleLowerCase('tr-TR')&&r.id!==id)){toast('Bu evrak numarası zaten kullanılıyor. Farklı bir numara girin.');return}let r={id,number,name:$('docName').value.trim(),date:$('docDate').value,category:$('docCategory').value.trim(),type:$('docType').value,department:$('docDepartment').value.trim(),description:$('docDescription').value.trim(),createdAt:old?old.createdAt:Date.now(),fileId:old?old.fileId:null,fileName:old?old.fileName:'',fileType:old?old.fileType:'',fileSize:old?old.fileSize:0};if(!r.name){toast('Belge adı zorunludur.');return}if(f){try{await filePut(id,f);r.fileId=id;r.fileName=f.name;r.fileType=f.type;r.fileSize=f.size;r.dataUrl=null}catch(err){toast('Dosya saklanamadı. Dosya boyutunu küçültüp tekrar deneyin.');return}}if(old){records=records.map(x=>x.id===id?r:x)}else records.push(r);if(!persist())return;updateStats();toast(old?'Kayıt güncellendi.':'Belge arşive kaydedildi. Evrak no: '+number);if(keepNew){clearForm()}else{clearForm();go('archive')}}
async function saveScan(e){e.preventDefault();let f=$('scanFile').files[0];if(!f){toast('Lütfen taranmış belge görseli seçin.');return}let id=uniqueId(),number=$('scanNo').value.trim()||genNo();if(records.some(r=>r.number.toLocaleLowerCase('tr-TR')===number.toLocaleLowerCase('tr-TR'))){toast('Bu evrak numarası zaten kullanılıyor.');return}try{await filePut(id,f)}catch(err){toast('Görsel saklanamadı. Tarayıcı depolama alanını kontrol edin.');return}records.push({id,number,name:$('scanName').value.trim(),date:$('scanDate').value||new Date().toISOString().slice(0,10),category:$('scanCategory').value.trim()||'Fotoğraf / Tarama',type:'Fotoğraf / Tarama',department:'',description:$('scanDescription').value.trim(),createdAt:Date.now(),fileId:id,fileName:f.name,fileType:f.type,fileSize:f.size});if(!records[records.length-1].name){records.pop();await fileDel(id);toast('Belge başlığı zorunludur.');return}if(!persist())return;updateStats();$('scanForm').reset();$('scanPreview').innerHTML='';toast('Taranan belge arşive kaydedildi: '+number);go('archive')}
async function handleAction(btn){let id=btn.dataset.id,act=btn.dataset.act,r=records.find(x=>x.id===id);if(!r)return;if(act==='view')await viewRecord(id);if(act==='download')await downloadRecord(r);if(act==='edit')startEdit(id);if(act==='pdf')pdfRecord(id);if(act==='delete'){if(!confirm('“'+r.name+'” kaydı silinsin mi?'))return;records=records.filter(x=>x.id!==id);await fileDel(id);persist();updateStats();toast('Kayıt silindi.')} }
document.addEventListener('click',e=>{let nav=e.target.closest('[data-page]');if(nav){go(nav.dataset.page);return}let goto=e.target.closest('[data-goto]');if(goto){go(goto.dataset.goto);if(goto.dataset.goto==='new')clearForm();return}let act=e.target.closest('[data-act]');if(act){handleAction(act);return}});
$('recordForm').addEventListener('submit',e=>saveRecord(e,false));$('saveNewAndNext').addEventListener('click',()=>saveRecord(null,true));$('clearForm').addEventListener('click',clearForm);
$('searchInput').addEventListener('input',renderArchive);['filterCategory','filterType','sortBy'].forEach(id=>$(id).addEventListener('change',renderArchive));$('searchBtn').addEventListener('click',renderArchive);$('refreshBtn').addEventListener('click',()=>{readRecords();updateStats();toast('Arşiv listesi yenilendi.')});$('resetFilters').addEventListener('click',()=>{$('searchInput').value='';$('filterCategory').value='';$('filterType').value='';$('sortBy').value='newest';renderArchive()});
$('scanForm').addEventListener('submit',saveScan);$('scanFile').addEventListener('change',()=>{let f=$('scanFile').files[0];if(!f){$('scanPreview').innerHTML='';return}if(f.type.startsWith('image/')){let u=URL.createObjectURL(f);$('scanPreview').innerHTML=`<img src="${u}" alt="Belge önizleme" style="max-width:100%;max-height:320px;border-radius:10px;border:1px solid #286544">`}else $('scanPreview').textContent='Seçilen dosya: '+f.name});$('resetScan').addEventListener('click',()=>{$('scanForm').reset();$('scanPreview').innerHTML=''});
$('quickSearchBtn').addEventListener('click',runQuickSearch);$('quickSearch').addEventListener('keydown',e=>{if(e.key==='Enter')runQuickSearch()});$('printList').addEventListener('click',printList);$('reportAll').addEventListener('click',printList);$('exportCsv').addEventListener('click',csvExport);
$('backupDownload').addEventListener('click',()=>{let blob=new Blob([JSON.stringify({app:'ETÜT ARŞİV',version:3,exportedAt:new Date().toISOString(),records},null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='etut-arsiv-yedek-'+new Date().toISOString().slice(0,10)+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),3000);toast('Kayıt bilgileri yedeği indirildi. Ekli dosyaları ayrıca indirin.')});
$('backupImportBtn').addEventListener('click',()=>$('backupImport').click());$('backupImport').addEventListener('change',async()=>{let f=$('backupImport').files[0];if(!f)return;try{let data=JSON.parse(await f.text()),arr=Array.isArray(data)?data:data.records;if(!Array.isArray(arr))throw Error('Yedek formatı tanınmadı');if(!confirm(arr.length+' kayıt içe aktarılsın mı? Aynı numaralı kayıtlar yinelenebilir.'))return;let existing=new Set(records.map(r=>r.id));arr.forEach(r=>{if(!existing.has(r.id)){if(!r.id)r.id=uniqueId();records.push(r)}});persist();updateStats();toast('Yedek içe aktarıldı. Ekli dosyalar JSON yedeğinde bulunmaz.');go('archive')}catch(e){toast('Yedek dosyası okunamadı: '+e.message)}finally{$('backupImport').value=''}});
$('deleteAll').addEventListener('click',async()=>{if(!confirm('TÜM kayıtlar silinsin mi? Bu işlem geri alınamaz. Önce yedek aldığınızdan emin olun.'))return;if(!confirm('Son onay: arşivdeki tüm kayıtlar silinecek. Devam edilsin mi?'))return;for(let r of records)if(r.fileId)await fileDel(r.fileId);records=[];persist();updateStats();toast('Arşiv kayıtları silindi.')});
$('docFile').addEventListener('change',()=>{let f=$('docFile').files[0];$('fileHint').textContent=f?'Seçildi: '+f.name+' · '+fmtSize(f.size):'Dosya seçilmezse sadece kayıt bilgileri kaydedilir.'});
(async()=>{await openDb();readRecords();clearForm();$('scanDate').value=new Date().toISOString().slice(0,10);updateStats();})();
})();
</script>
