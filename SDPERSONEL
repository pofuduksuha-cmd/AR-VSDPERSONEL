ters{display:grid;grid-template-columns:1.2fr 1fr 1fr auto;gap:9px;margin-bottom:13px}.tablewrap{overflow:auto;border:1px solid #16432b;border-radius:12px}table{border-collapse:collapse;width:100%;min-width:760px}th{background:#0b2b1a;color:#a8d8bb;text-align:left;font-weight:600;font-size:12px;padding:12px 10px;white-space:nowrap}td{padding:12px 10px;border-top:1px solid #163523;font-size:13px;vertical-align:middle}tbody tr:hover{background:#0d2819}td.name{font-weight:700;max-width:240px}td small{display:block;color:var(--muted);font-weight:400;margin-top:3px}.pill{display:inline-block;border:1px solid #24764a;color:#aaffc8;background:#0b3520;border-radius:7px;padding:4px 8px;font-size:11px;white-space:nowrap}.rowbuttons{display:flex;gap:5px}.rowbuttons button{padding:6px 8px;border-radius:8px}.empty{text-align:center;color:var(--muted);padding:35px}.bottomline{display:flex;align-items:center;justify-content:space-between;gap:10px;padding-top:13px;color:var(--muted);font-size:12px}.previewbox{padding:18px}.previewdoc{background:#fff;color:#1b2c23;border-radius:8px;min-height:260px;padding:18px;text-align:center;box-shadow:0 8px 22px #0004}.previewdoc .docmark{font-size:42px;color:#0a8742}.previewdoc h3{font-size:15px;margin:9px 0}.previewdoc p{font-size:11px;color:#5c6b61;overflow-wrap:anywhere}.previewdoc hr{border:0;border-top:2px solid #0ba64e;width:55%;margin:15px auto}.previewmeta{margin:13px 0;color:var(--muted);font-size:12px;overflow-wrap:anywhere}.previewmeta b{display:block;color:var(--text);font-size:14px;margin-bottom:3px}.previewbuttons{display:grid;grid-template-columns:1fr 1fr;gap:7px}.previewbuttons button{font-size:12px;padding:10px 5px}.section{display:none}.section.active{display:block}.formgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.field.full{grid-column:1/-1}.formactions{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}.hint{color:var(--muted);font-size:12px;margin-top:6px}.filedrop{border:1px dashed #36865a;border-radius:12px;padding:17px;background:#081b10}.filedrop input{background:transparent;border:0;padding:7px 0}.notice{padding:12px 14px;border:1px solid #24563a;background:#0b2818;border-radius:10px;color:#b9f5ce;font-size:13px;margin-bottom:14px}.settingsrow{display:flex;justify-content:space-between;align-items:center;gap:15px;padding:15px 0;border-bottom:1px solid #173c28}.toast{position:fixed;right:22px;bottom:22px;max-width:360px;padding:14px 18px;background:#0b3b21;border:1px solid #31d777;border-radius:12px;box-shadow:var(--shadow);display:none;z-index:99}.toast.show{display:block}.smallbtn{font-size:12px;padding:7px 9px}.mobilemenu{display:none}
